        "label": "Code",
        "inputs": {
          "code": "info = {}\n\ndef probe(name, obj):\n    try:\n        info[name + \"_type\"] = str(type(obj))\n        info[name + \"_attrs\"] = str([a for a in dir(obj) if not a.startswith(\"__\")])[:400]\n        info[name + \"_repr\"] = str(obj)[:300]\n    except Exception as e:\n        info[name + \"_err\"] = str(e)\n\nprobe(\"_input\", _input)\nprobe(\"_json\", _json)\nprobe(\"_node\", _node)\n\n# Common accessor shapes\nfor expr in [\"_input.all()\", \"_input.first()\", \"_input.item\", \"_input.json\",\n             \"_json.brand_kit_id\", \"_node.input\"]:\n    try:\n        info[expr] = str(eval(expr))[:300]\n    except Exception as e:\n        info[expr] = \"err: \" + type(e).__name__\n\nreturn [{\"json\": info}]",
          "mode": "all",
          "language": "python"
        },
