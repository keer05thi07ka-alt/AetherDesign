          "language": "python",
          "code": "\"\"\"\nExtract the query embedding and recover org_id.\n\nThe HTTP Request node replaces $json, so the verified JWT claims are gone.\n_node._node_results holds every node's output — that is how org_id is\nrecovered without trusting anything from the request body.\n\"\"\"\n\nresp = _json.get(\"body\", {})\nvalues = resp.get(\"embedding\", {}).get(\"values\", [])\n\norg_id, query_text, limit = \"\", \"\", 5\nprobe = \"not-attempted\"\n\ntry:\n    results = _node._node_results\n    probe = \"keys=\" + str(list(results.keys()))[:200]\n\n    for _, payload in results.items():\n        items = payload if isinstance(payload, list) else payload.get(\"items\", [])\n        for item in items:\n            j = item.get(\"json\", {}) if isinstance(item, dict) else {}\n            if \"jwt\" in j and isinstance(j[\"jwt\"], dict):\n                org_id = j[\"jwt\"].get(\"org_id\", \"\")\n                body = j.get(\"body\", {})\n                query_text = body.get(\"query\", \"\")\n                limit = int(body.get(\"limit\", 5) or 5)\n                break\n        if org_id:\n            break\nexcept Exception as e:\n    probe = \"error: \" + type(e).__name__ + \": \" + str(e)[:150]\n\nreturn [{\n    \"json\": {\n        \"org_id\": org_id,\n        \"query\": query_text,\n        \"limit\": max(1, min(limit, 20)),\n        \"dims\": len(values),\n        \"embedding_json\": json.dumps(values),\n        \"probe\": probe,\n    }\n}]",
          "schemaMode": "list",
