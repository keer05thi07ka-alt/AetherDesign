    {
      "id": "postgres.executeQuery-1785993188167",
      "data": {
        "label": "Execute Query",
        "inputs": {
          "queryParameters": [
            " {{$node[\"webhook-1785993024192\"].json[\"jwt\"][\"org_id\"]}}",
            " {{$node[\"webhook-1785993024192\"].json[\"params\"][\"resource\"]}}",
            "{{ $json.query.id || '' }}"
          ],
          "query": "select coalesce(\r\n  case $2::text\r\n\r\n    when 'campaigns' then (\r\n      select json_agg(t) from (\r\n        select id, name, brief, audience, platform, status, deadline,\r\n               brand_kit_id, assigned_to, created_by, created_at\r\n        from campaigns\r\n        where org_id = $1\r\n          and (nullif($3,'')::uuid is null or id = nullif($3,'')::uuid)\r\n        order by created_at desc limit 100\r\n      ) t)\r\n\r\n    when 'assets' then (\r\n      select json_agg(t) from (\r\n        select id, campaign_id, brand_kit_id, title, description, category,\r\n               status, current_version, width, height, storage_path,\r\n               thumbnail_path, quality_score, created_by, created_at\r\n        from assets\r\n        where org_id = $1\r\n          and (nullif($3,'')::uuid is null or id = nullif($3,'')::uuid)\r\n        order by created_at desc limit 100\r\n      ) t)\r\n\r\n    when 'asset_versions' then (\r\n      select json_agg(t) from (\r\n        select id, asset_id, version_no, storage_path, prompt, negative_prompt,\r\n               model, params, locale, quality_score, created_by, created_at\r\n        from asset_versions\r\n        where org_id = $1\r\n          and (nullif($3,'')::uuid is null or asset_id = nullif($3,'')::uuid)\r\n        order by asset_id, version_no desc limit 100\r\n      ) t)\r\n\r\n    when 'brand_kits' then (\r\n      select json_agg(t) from (\r\n        select id, name, tokens, created_by, created_at,\r\n               length(coalesce(guidelines_text,'')) as guidelines_length\r\n        from brand_kits\r\n        where org_id = $1\r\n          and (nullif($3,'')::uuid is null or id = nullif($3,'')::uuid)\r\n        order by created_at desc limit 100\r\n      ) t)\r\n\r\n    when 'approvals' then (\r\n      select json_agg(t) from (\r\n        select id, asset_id, asset_version_id, reviewer_id, decision, comment,\r\n               requested_by, requested_at, decided_at\r\n        from approvals\r\n        where org_id = $1\r\n          and (nullif($3,'')::uuid is null or asset_id = nullif($3,'')::uuid)\r\n        order by requested_at desc limit 100\r\n      ) t)\r\n\r\n    when 'generation_jobs' then (\r\n      select json_agg(t) from (\r\n        select id, campaign_id, brand_kit_id, prompt, refined_prompt, status,\r\n               progress, error_message, result_asset_id, created_by, created_at\r\n        from generation_jobs\r\n        where org_id = $1\r\n          and (nullif($3,'')::uuid is null or id = nullif($3,'')::uuid)\r\n        order by created_at desc limit 100\r\n      ) t)\r\n\r\n    when 'templates' then (\r\n      select json_agg(t) from (\r\n        select id, title, category, spec, preview_path, is_public, created_at\r\n        from templates\r\n        where (org_id = $1 or org_id is null)\r\n          and (nullif($3,'')::uuid is null or id = nullif($3,'')::uuid)\r\n        order by title limit 100\r\n      ) t)\r\n\r\n    when 'members' then (\r\n      select json_agg(t) from (\r\n        select u.id, u.email, u.full_name, u.avatar_url, m.role\r\n        from memberships m\r\n        join users u on u.id = m.user_id\r\n        where m.org_id = $1\r\n        order by u.full_name limit 100\r\n      ) t)\r\n\r\n  end, '[]'::json) as data;",
          "replaceEmptyStringsWithNull": false,
          "outputLargeNumbersAsText": false,
          "schemaMode": "list",
          "tableMode": "list",
          "columnsMode": "manually",
